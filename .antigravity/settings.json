{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "tokyo night",
  "enableTelemetry": false,
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/immich"
      ]
    }
  },
  "model": "Gemini 3.1 Pro (High)",
  "permissions": {
    "allow": [
      "command(*)",
      "read_file(*)",
      "read_dir(*)",
      "mcp(*)"
    ]
  },
  "trustedWorkspaces": [
    "/home/kevin/.dotfiles",
    "/opt/system-dotfiles"
  ]
}