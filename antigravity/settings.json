{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "tokyo night",
  "enableTelemetry": false,
  "mcpServers": {
    "homeassistant": {
      "command": "npx",
      "args": [
        "-y",
        "@server/home-assistant"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@server/docker"
      ]
    }
  },
  "model": "Gemini 3.1 Pro (High)",
  "permissions": {
    "allow": [
      "command(ls)",
      "command(cat)",
      "command(find)",
      "command(grep)",
      "command(dig)",
      "command(ping)",
      "command(curl)",
      "command(ssh nas-01 ls)",
      "command(ssh nas-01 cat)",
      "command(ssh nas-01 docker ps)",
      "command(ssh nas-01 docker logs)",
      "command(ssh nas-01 grep)",
      "command(ssh nas-01 find)",
      "command(ssh nas-01 tail)",
      "command(ssh nas-01 head)",
      "command(ssh nas-01 systemctl status)",
      "command(ssh nas-01 journalctl)",
      "command(ssh kevin@nas-01 ls)",
      "command(ssh kevin@nas-01 cat)",
      "command(ssh kevin@nas-01 systemctl status)",
      "command(git)",
      "command(docker)",
      "command(systemctl)",
      "command(journalctl)",
      "command(ansible)",
      "command(ansible-playbook)",
      "command(tailscale)",
      "command(npm)",
      "command(which)",
      "command(resolvectl)",
      "command(ip)",
      "command(ps)",
      "command(top)",
      "command(free)",
      "command(head)",
      "command(tail)",
      "command(groups)",
      "command(cd)",
      "command(sort)",
      "command(tree)",
      "command(pgrep)",
      "command(hyprctl)",
      "command(wc)",
      "command(echo)",
      "command(agy)",
      "command(sudo ls)",
      "command(sudo cat)",
      "command(sudo git)",
      "command(sudo find)",
      "command(sudo docker)"
    ]
  },
  "trustedWorkspaces": [
    "/home/kevin/.dotfiles",
    "/opt/system-dotfiles"
  ]
}
