# Vaultwarden auf Port 8080 (HTTPS via Caddy)
# Hinweis: Falls Vaultwarden in einem anderen Compose-File ist, muss es im gleichen Netzwerk sein
nas-01.taildfad90.ts.net:8080 {
    tls {
        get_certificate tailscale
    }
    reverse_proxy vaultwarden:80
}

# Immich auf Port 2283 (HTTPS via Caddy)
nas-01.taildfad90.ts.net:2283 {
    tls {
        get_certificate tailscale
    }
    reverse_proxy immich-server:2283
}

# Semaphore (Ansible UI)
nas-01.taildfad90.ts.net:3000 {
    tls {
        get_certificate tailscale
    }
    reverse_proxy semaphore:3000
}

# Grafana (Monitoring Dashboards)
nas-01.taildfad90.ts.net:3001 {
    tls {
        get_certificate tailscale
    }
    reverse_proxy grafana:3000
}

# Prometheus (Metrics)
nas-01.taildfad90.ts.net:9090 {
    tls {
        get_certificate tailscale
    }
    reverse_proxy prometheus:9090
}
